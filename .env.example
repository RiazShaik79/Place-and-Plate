# Plate & Pace environment variables. Names only: copy to .env and fill in. Never commit real values.
# See the table in CLAUDE.md for what each one does.

# --- Database (required) ---
DATABASE_URL=mysql://user:password@127.0.0.1:3306/plate_and_pace
# Hosted MySQL with ?ssl-mode=REQUIRED (Aiven): the provider's CA certificate, PEM
DATABASE_CA_CERT=
# Optional separate database for npm test
TEST_DATABASE_URL=

# --- App ---
APP_URL=

# --- Third-party APIs (cost quota; never used by tests) ---
GEMINI_API_KEY=
GEMINI_MODEL=
GOOGLE_MAPS_API_KEY=

# --- Observability (all optional; unset = off) ---
# Sentry: server DSN, browser DSN (needed at build time), and source-map upload on the Render build
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Log queries slower than this many ms (default 1000)
SLOW_QUERY_MS=
# "pretty" for readable local logs; JSON otherwise
LOG_FORMAT=
# Temporary: 32+ random chars enables /api/debug/error for one end-to-end test. Unset afterwards.
DEBUG_ERROR_TOKEN=
